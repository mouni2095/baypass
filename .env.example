# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase project (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic API key, used only on the server for the "Describe your parking" feature
ANTHROPIC_API_KEY=
# Optional: which Claude model to use for layout parsing
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: a simple shared password for the staff desk and venue editor during the pilot
BAYPASS_STAFF_PIN=
